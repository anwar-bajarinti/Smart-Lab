# Node dependencies
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Production build output
dist/
**/dist/
dist-ssr/
build/
**/build/
*.local

# Environment variables & secrets (NEVER commit secrets or keys)
.env
.env.*
.env.local
.env.*.local
*.env
**/.env
**/.env.*
**/.env.local
**/.env.*.local
!**/.env.example

# Python artifacts
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
.venv/
env/
venv/

# Cloudflare & tooling
.wrangler/
**/.wrangler/

# Temporary and legacy folders
backups/
scratch/

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
